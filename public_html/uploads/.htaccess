# Uploads Klasörü Güvenlik Duvarı
# PHP ve Script Dosyalarının Çalıştırılmasını Engeller

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|asp|js)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Sadece Görsel ve Güvenli Dosya Tiplerine İzin Ver
<FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg|pdf)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Dizin Listelemeyi Kapat
Options -Indexes
