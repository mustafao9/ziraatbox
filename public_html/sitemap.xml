<?php
require_once "sistem/ayar.php";

// Tarayıcıya bunun bir XML dosyası olduğunu söylüyoruz
header("Content-Type: text/xml; charset=utf-8");

echo '<?xml version="1.0" encoding="UTF-8"?>';
echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">';

// 1. ANA SAYFA
echo '<url>
        <loc>'.URL.'/</loc>
        <lastmod>'.date('Y-m-d').'</lastmod>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
      </url>';

// 2. KATEGORİLER
$kategoriler = $db->query("SELECT slug FROM kategoriler WHERE aktif = 1");
foreach($kategoriler as $kat) {
    echo '<url>
            <loc>'.URL.'/kategori.php?slug='.$kat['slug'].'</loc>
            <changefreq>weekly</changefreq>
            <priority>0.8</priority>
          </url>';
}

// 3. İLANLAR (En Önemlisi)
// Sadece aktif olan ilanları çekiyoruz
$ilanlar = $db->query("SELECT id, created_at FROM ilanlar WHERE durum = 'aktif' ORDER BY id DESC");
foreach($ilanlar as $ilan) {
    echo '<url>
            <loc>'.URL.'/ilan-detay.php?id='.$ilan['id'].'</loc>
            <lastmod>'.date('Y-m-d', strtotime($ilan['created_at'])).'</lastmod>
            <changefreq>daily</changefreq>
            <priority>0.9</priority>
          </url>';
}

// 4. KURUMSAL SAYFALAR
echo '<url><loc>'.URL.'/hakkimizda.php</loc><priority>0.5</priority></url>';
echo '<url><loc>'.URL.'/kvkk.php</loc><priority>0.5</priority></url>';

echo '</urlset>';
?>